---
import { t, type Locale } from "../lib/i18n";
import { links } from "../lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const prefix = locale === "es" ? "" : "/en";
---

<nav class="sticky top-0 z-50 bg-bg-primary/90 backdrop-blur border-b border-white/10">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href={`${prefix}/`} class="font-display text-accent-yellow text-lg tracking-tight uppercase">
      Hot Dog Maracay
    </a>

    <div class="hidden md:flex items-center gap-6 text-sm">
      <a href={`${prefix}/#menu`} class="hover:text-accent-orange transition">{t(locale, "nav.menu")}</a>
      <a href={`${prefix}/#location`} class="hover:text-accent-orange transition">{t(locale, "nav.find")}</a>
      <div class="flex items-center gap-3">
        <a href={links.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-white/70 hover:text-accent-orange transition">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href={links.tiktok} target="_blank" rel="noopener" aria-label="TikTok" class="text-white/70 hover:text-accent-orange transition">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.94a8.16 8.16 0 0 0 4.77 1.52V7a4.85 4.85 0 0 1-1.84-.31z"/>
          </svg>
        </a>
      </div>
      <a href={links.uberEats} target="_blank" rel="noopener" class="bg-accent-orange text-black font-bold px-4 py-2 rounded-md hover:brightness-110 transition">
        {t(locale, "nav.order")} ↗
      </a>
      <div class="inline-flex items-center rounded-full border border-white/20 text-xs font-semibold" role="group" aria-label="Language">
        <button type="button" data-lang-switch="es" aria-pressed={locale === "es"} class:list={["px-3 py-1 rounded-full transition", locale === "es" ? "bg-accent-orange text-black" : "text-white/70"]}>ES</button>
        <button type="button" data-lang-switch="en" aria-pressed={locale === "en"} class:list={["px-3 py-1 rounded-full transition", locale === "en" ? "bg-accent-orange text-black" : "text-white/70"]}>EN</button>
      </div>
    </div>

    <div class="md:hidden flex items-center gap-3">
      <a href={links.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-white/70 hover:text-accent-orange transition">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
      <a href={links.tiktok} target="_blank" rel="noopener" aria-label="TikTok" class="text-white/70 hover:text-accent-orange transition">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.94a8.16 8.16 0 0 0 4.77 1.52V7a4.85 4.85 0 0 1-1.84-.31z"/>
        </svg>
      </a>
      <div class="inline-flex items-center rounded-full border border-white/20 text-xs font-semibold" role="group" aria-label="Language">
        <button type="button" data-lang-switch="es" aria-pressed={locale === "es"} class:list={["px-3 py-1 rounded-full transition", locale === "es" ? "bg-accent-orange text-black" : "text-white/70"]}>ES</button>
        <button type="button" data-lang-switch="en" aria-pressed={locale === "en"} class:list={["px-3 py-1 rounded-full transition", locale === "en" ? "bg-accent-orange text-black" : "text-white/70"]}>EN</button>
      </div>
      <button id="mobile-menu-toggle" type="button" class="text-white text-2xl leading-none" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        ≡
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-white/10 bg-bg-primary">
    <div class="max-w-6xl mx-auto px-4 py-6 flex flex-col gap-4 text-base">
      <a href={`${prefix}/#menu`} class="py-2 hover:text-accent-orange">{t(locale, "nav.menu")}</a>
      <a href={`${prefix}/#location`} class="py-2 hover:text-accent-orange">{t(locale, "nav.find")}</a>
      <a href={links.uberEats} target="_blank" rel="noopener" class="bg-accent-orange text-black font-bold py-3 text-center rounded-md">
        {t(locale, "nav.order")} ↗
      </a>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  // Language switch (vanilla — no React)
  document.querySelectorAll<HTMLButtonElement>("[data-lang-switch]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.langSwitch as "es" | "en";
      try { localStorage.setItem("preferredLocale", target); } catch {}
      const hash = window.location.hash || "";
      window.location.href = (target === "es" ? "/" : "/en/") + hash;
    });
  });

  // Remember the current locale on page load so the auto-redirect snippet
  // in Base.astro has something to compare against on the next visit.
  try {
    const isEn = window.location.pathname.startsWith("/en");
    localStorage.setItem("preferredLocale", isEn ? "en" : "es");
  } catch {}
</script>
